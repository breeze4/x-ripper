{
  "manifest_version": 3,
  "name": "X Ripper",
  "version": "0.1.0",
  "description": "Save X articles and threads as Markdown with embedded media links.",
  "action": {
    "default_title": "Save X as Markdown",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://*.twimg.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
